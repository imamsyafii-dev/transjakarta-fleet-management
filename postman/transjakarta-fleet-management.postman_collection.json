{
  "info": {
    "name": "Transjakarta Fleet Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "vehicle_id",
      "value": "B1234XYZ"
    },
    {
      "key": "start",
      "value": "1"
    },
    {
      "key": "end",
      "value": "2000000000"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Get Latest Vehicle Location",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/vehicles/{{vehicle_id}}/location"
      }
    },
    {
      "name": "Get Vehicle Location History",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/vehicles/{{vehicle_id}}/history?start={{start}}&end={{end}}"
      }
    }
  ]
}